# AI Provider: "ollama" or "gemini"
AI_PROVIDER="ollama"
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_CHAT_MODEL="minicpm-v:latest"
OLLAMA_VISION_MODEL="minicpm-v:latest"

# GEMINI_API_KEY: Optional if using local Ollama
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

